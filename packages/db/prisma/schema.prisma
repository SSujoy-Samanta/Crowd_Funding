// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id                  Int       @id  @default(autoincrement())
  username            String 
  email               String    @unique
  password            String
  verified            Boolean   @default(false)
  otp                 Otp?
  address             Address?
  campaigns           Campaign[]   @relation("UserCampaigns") // A user can create multiple campaigns
  campaignMetaData    CampaignMetadata[]   @relation("UserCampaignMetadata") 
}
model Otp {
  id        Int      @id @default(autoincrement())
  OTP       String
  created   DateTime @default(now())
  expired   DateTime
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
}
model  Address{
  id        Int      @id @default(autoincrement())
  country   String
  mobile    String?
  state     String?
  city      String?
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
}
model VerifyEmail{
  id        Int      @id  @default(autoincrement())
  OTP       String
  email     String        @unique  
  verified  Boolean       @default(false)
  created   DateTime      @default(now())
  expired   DateTime
}
model Campaign {
  id              Int          @id    @default(autoincrement())
  userId          Int
  user            User         @relation(fields: [userId], references: [id], name: "UserCampaigns")
  walletAddress   String?      
  Goal            String       @default("0.0")
  raised          String       @default("0.0")
  deployedAddress String?      @unique
  VotingSuccess   Boolean      @default(false)
  withdrawn       Boolean      @default(false)
  transactionHash String       @unique
  votingStatus    VotingStatus @default(Pending)
  contributors    Contributor[] // A campaign can have multiple contributors
  metadataId      Int          @unique
  metadata        CampaignMetadata @relation(fields: [metadataId], references: [id])
  comments        Comments[]   
}
model CampaignMetadata {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], name: "UserCampaignMetadata")
  campaign      Campaign?
  title         String    
  description   String
  category      String
  goal          String    @default("0.0")
  imageUrl      String?
  tags          String[]  @default([])
  country       String
  state         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


model Contributor {
  id              Int       @id  @default(autoincrement())
  campaignId      Int
  campaign        Campaign  @relation(fields: [campaignId], references: [id])
  walletAddress   String      
  amount          String    @default("0.0")
  transactionHash String[]  @default([])
  email           String?   
  vote            Vote      @default(pending)
  refunded        Boolean   @default(false)
  timestamp       DateTime  @default(now()) 
}
model ProcessBlock {
  id         Int    @id @default(1) 
  lastBlock  String @default("0") 
}

model IndexedEvent {
  id               Int  @id  @default(autoincrement())// Use transaction hash as unique ID
  transactionHash  String
  blockNumber      Int
  logIndex         Int
  eventName        String
  createdAt        DateTime @default(now())

  @@unique([blockNumber, logIndex])  // Ensure no duplicate logs
}

model Comments{
  id           Int  @id  @default(autoincrement())
  comment      String
  wallet       String
  campaignId   Int
  campaign        Campaign  @relation(fields: [campaignId], references: [id])
  timestamp       DateTime  @default(now()) 
}

enum VotingStatus {
  Pending
  OnGoing
  Completed    
}

enum Vote {
  pending
  yes
  no   
}