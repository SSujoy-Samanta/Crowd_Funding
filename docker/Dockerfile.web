FROM node:latest

WORKDIR /app

# Copy package files first for better caching
COPY package.json package-lock.json turbo.json ./
COPY packages/db/package.json ./packages/db/
COPY packages/common/package.json ./packages/common/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN npm install

# Copy the rest of the code
COPY packages ./packages
COPY apps/web ./apps/web

# Generate Prisma client with a placeholder URL
# This generates the Prisma client code but doesn't need a real connection
RUN npm run db:generate

# Build the application
RUN npm run build

EXPOSE 3001

# Create a startup script to regenerate prisma client at runtime if needed
RUN echo '#!/bin/sh\ncd /app/packages/db && npx prisma generate\ncd /app && npm run start-web-app' > /app/start.sh
RUN chmod +x /app/start.sh

# Use the startup script as the entrypoint
CMD ["/app/start.sh"]