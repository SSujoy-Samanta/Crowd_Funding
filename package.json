{
  "name": "@repo/cfapp",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "cd packages/db && npx prisma generate && cd ../..",
    "start-web-app": "cd ./apps/web && npm run start",
    "start-backend-app": "cd ./apps/backend && npm run start",
    "start-workers-app": "cd ./apps/workers && npm run start"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "next-auth": {
      "next": "14.2.24"
    }
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/dotenv": "^6.1.1"
  }
}
